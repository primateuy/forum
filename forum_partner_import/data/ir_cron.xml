<odoo>
  <data noupdate="1">
    <!-- Procesa las tandas pendientes. Arranca desactivado: lo activa el
         propio batch al iniciar el procesamiento, y se autodesactiva al
         terminar. -->
    <record id="ir_cron_forum_partner_import" model="ir.cron">
      <field name="name">FORUM: importación masiva de clientes</field>
      <field name="model_id" ref="model_forum_import_batch"/>
      <field name="state">code</field>
      <field name="code">model._cron_procesar()</field>
      <field name="interval_number">2</field>
      <field name="interval_type">minutes</field>
      <field name="numbercall">-1</field>
      <field name="doall" eval="False"/>
      <field name="active" eval="False"/>
    </record>
  </data>
</odoo>
