<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="forum_partner_import.LiveProgress">
    <div class="o_forum_import_progress">
      <t t-foreach="secciones" t-as="sec" t-key="sec.clave">
        <div t-att-class="sec_last ? '' : 'mb-4 pb-3 border-bottom'">

          <!-- Título de la fase: solo cuando el tipo tiene más de una -->
          <h5 t-if="sec.titulo" class="mb-2" t-esc="sec.titulo"/>

          <!-- Barra -->
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="progress flex-grow-1" style="height: 22px;">
              <div class="progress-bar"
                   t-att-class="sec.hayErrores ? 'bg-warning' : (sec.corriendo ? 'progress-bar-striped progress-bar-animated bg-primary' : 'bg-success')"
                   role="progressbar"
                   t-attf-style="width: {{ sec.porcentaje }}%;"
                   t-att-aria-valuenow="sec.porcentaje"
                   aria-valuemin="0" aria-valuemax="100">
                <span class="fw-bold"><t t-esc="sec.porcentaje"/>%</span>
              </div>
            </div>
            <span class="text-muted small text-nowrap" t-esc="sec.detalleBarra"/>
          </div>

          <!-- Etapa actual, solo mientras se arma el staging -->
          <div t-if="sec.cargando and sec.etapa" class="alert alert-info py-2 mb-2">
            <i class="fa fa-cog fa-spin me-1"/>
            <strong t-esc="sec.etapa"/>
            <span class="text-muted ms-2">
              Se está armando la tabla de trabajo. Podés cerrar esta pantalla.
            </span>
          </div>

          <!-- Cronómetro y ETA -->
          <div class="d-flex flex-wrap gap-4 mb-2">
            <div>
              <span class="text-muted small d-block">Transcurrido</span>
              <span class="fs-5 font-monospace" t-esc="sec.transcurrido"/>
            </div>
            <div t-if="sec.corriendo">
              <span class="text-muted small d-block">Restante estimado</span>
              <span class="fs-5 font-monospace text-primary" t-esc="sec.eta"/>
            </div>
            <div t-if="sec.corriendo and sec.ritmoTexto">
              <span class="text-muted small d-block">Ritmo</span>
              <span class="fs-5 font-monospace" t-esc="sec.ritmoTexto"/>
            </div>
            <div t-if="sec.estadoFinal">
              <span class="text-muted small d-block">Estado</span>
              <span class="fs-5"
                    t-att-class="sec.estadoFinal === 'done' ? 'text-success' : (sec.estadoFinal === 'error' ? 'text-danger' : 'text-muted')">
                <t t-if="sec.estadoFinal === 'done'">Terminado</t>
                <t t-elif="sec.estadoFinal === 'error'">Con error</t>
                <t t-else="">Cancelado</t>
              </span>
            </div>
          </div>

          <!-- Contadores: no aplican mientras se arma el staging -->
          <t t-if="!sec.cargando">
            <t t-foreach="sec.filasContadores" t-as="fila" t-key="fila_index">
              <div t-att-class="fila_index ? 'row g-2 mt-1' : 'row g-2'">
                <t t-foreach="fila" t-as="c" t-key="c_index">
                  <div t-att-class="sec.claseColumna(fila)">
                    <div t-att-class="c.claseCaja">
                      <div class="text-muted small" t-esc="c.etiqueta"/>
                      <div t-att-class="c.claseValor" t-esc="c.texto"/>
                    </div>
                  </div>
                </t>
              </div>
            </t>
          </t>

          <div t-if="sec.corriendo and !sec.cargando" class="text-muted small mt-2">
            <i class="fa fa-refresh fa-spin me-1"/>
            Actualizándose solo. Podés cerrar la pantalla: el proceso sigue en segundo plano.
          </div>
        </div>
      </t>
    </div>
  </t>

</templates>
