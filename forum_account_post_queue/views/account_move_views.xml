<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_post_queue" model="ir.ui.view">
        <field name="name">account.move.form.forum.post.queue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="forum_post_queue_state" invisible="1" />
                <field name="forum_post_queue_error" invisible="1" />
                <div
                    class="alert alert-info mb-0"
                    role="alert"
                    invisible="forum_post_queue_state != 'queued'"
                >
                    <span>Esta factura está <b>en cola para registrarse</b>. Se
                        va a registrar sola en los próximos minutos. Si la
                        necesitás ya, usá el botón Confirmar.</span>
                    <button
                        name="action_forum_dequeue"
                        type="object"
                        string="Quitar de la cola"
                        class="btn-link"
                        groups="account.group_account_invoice"
                    />
                </div>
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="forum_post_queue_state != 'error'"
                >
                    <span><b>No se pudo registrar automáticamente.</b></span>
                    <div class="mt-1">
                        <field name="forum_post_queue_error" readonly="1" nolabel="1" />
                    </div>
                    <button
                        name="action_forum_requeue"
                        type="object"
                        string="Reintentar"
                        class="btn-link"
                        groups="account.group_account_invoice"
                    />
                    <button
                        name="action_forum_dequeue"
                        type="object"
                        string="Quitar de la cola"
                        class="btn-link"
                        groups="account.group_account_invoice"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_post_queue" model="ir.ui.view">
        <field name="name">account.invoice.tree.forum.post.queue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field
                    name="forum_post_queue_state"
                    optional="hide"
                    widget="badge"
                    decoration-info="forum_post_queue_state == 'queued'"
                    decoration-danger="forum_post_queue_state == 'error'"
                />
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_post_queue" model="ir.ui.view">
        <field name="name">account.invoice.select.forum.post.queue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='cancel']" position="after">
                <separator />
                <filter
                    name="forum_post_queued"
                    string="En cola de registro"
                    domain="[('forum_post_queue_state', '=', 'queued')]"
                />
                <filter
                    name="forum_post_error"
                    string="Con error al registrar"
                    domain="[('forum_post_queue_state', '=', 'error')]"
                />
            </xpath>
        </field>
    </record>
</odoo>
