<odoo>
  <data>

    <record id="view_forum_import_batch_form" model="ir.ui.view">
      <field name="name">forum.import.batch.form</field>
      <field name="model">forum.import.batch</field>
      <field name="arch" type="xml">
        <form string="Importación de clientes FORUM">
          <header>
            <button name="action_cargar_staging" type="object" class="btn-primary"
                    string="1. Cargar staging"
                    invisible="state not in ('draft', 'error', 'ready')"
                    confirm="Se va a leer el CSV completo y crear la tabla staging. Puede demorar unos minutos. ¿Continuar?"/>
            <button name="action_iniciar" type="object" class="btn-primary"
                    string="2. Iniciar procesamiento"
                    invisible="import_type != 'clientes' or state != 'ready'"
                    confirm="Antes de empezar se genera un respaldo de las tarjetas del programa. El procesamiento corre en segundo plano y PISA los puntos de las tarjetas que se asignen. ¿Continuar?"/>
            <button name="action_iniciar" type="object" class="btn-primary"
                    string="2. Cargar conteo en los quants"
                    invisible="import_type != 'inventario' or state != 'ready'"
                    confirm="Se escribe la cantidad contada en los quants de cada sucursal (crea los que no existen, con stock 0). No mueve stock ni contabilidad: eso lo hace el paso 3. Bloquea la tabla de quants unas décimas de segundo por tanda. ¿Continuar?"/>
            <button name="action_aplicar_ajuste" type="object" class="btn-primary"
                    string="3. Aplicar ajuste por tandas"
                    invisible="import_type != 'inventario' or state != 'done'"
                    confirm="Se crean los movimientos de inventario, la valuación y los asientos de cada quant con diferencia, por tandas en segundo plano. Correrlo DE NOCHE con las sucursales cerradas: cada tanda bloquea los quants que ajusta y compite con el POS. La cantidad final queda igual al contado, aunque se haya vendido algo después de la carga. ¿Continuar?"/>
            <button name="action_publicar_asientos" type="object" class="btn-primary"
                    string="4. Publicar asientos"
                    invisible="import_type != 'inventario' or state != 'applied'"
                    confirm="Se publican por tandas los asientos que la aplicación dejó en borrador. La numeración del diario la asigna Odoo, correlativa. Antes de arrancar se verifica que exista la cotización de la moneda secundaria para la fecha de los asientos. ¿Continuar?"/>
            <button name="action_conciliar" type="object" class="btn-primary"
                    string="5. Conciliar"
                    invisible="import_type != 'inventario' or state != 'posted'"
                    confirm="Concilia por tandas las líneas del ajuste en cuentas conciliables, agrupadas por producto y cuenta, igual que lo haría Odoo al publicar por el camino estándar. Normalmente ya corrió encadenada a la publicación: este botón es para relanzarla. ¿Continuar?"/>
            <button name="action_verificar_invariantes" type="object" class="btn-secondary"
                    string="Verificar invariantes"
                    invisible="import_type != 'inventario' or state not in ('applied', 'posted', 'reconciled', 'error', 'cancel')"/>
            <button name="action_reanudar" type="object" class="btn-primary"
                    string="Reanudar" invisible="state not in ('cancel', 'error')"/>
            <button name="action_cancelar" type="object" class="btn-secondary"
                    string="Cancelar procesamiento" invisible="state not in ('processing', 'applying', 'posting')"/>
            <button name="action_backup_tarjetas" type="object" class="btn-secondary"
                    string="Generar backup ahora"
                    invisible="import_type != 'clientes' or state in ('done', 'cancel')"/>
            <button name="action_exportar_errores" type="object" class="btn-secondary"
                    string="Exportar errores" invisible="import_type != 'clientes' or errors == 0"/>
            <button name="action_exportar_errores" type="object" class="btn-secondary"
                    string="Exportar errores e ignoradas"
                    invisible="import_type != 'inventario' or state in ('draft', 'loading') or (errors == 0 and ignored == 0 and apply_errors == 0)"/>
            <button name="action_exportar_duplicados" type="object" class="btn-secondary"
                    string="Exportar duplicados"
                    invisible="import_type != 'clientes' or state in ('draft', 'loading')"/>
            <button name="action_reparar_defaults" type="object" class="btn-secondary"
                    string="Reparar campos obligatorios"
                    invisible="import_type != 'clientes' or state == 'processing'"
                    confirm="Se completan en TODOS los contactos los campos de selección con valor por defecto que hayan quedado vacíos (advertencias de venta, compra, recolección y factura). Solo toca los que están vacíos. ¿Continuar?"/>
            <button name="action_reparar_direcciones" type="object" class="btn-secondary"
                    string="Completar calle"
                    invisible="import_type != 'clientes' or state in ('draft', 'loading', 'processing')"
                    confirm="Se copia el domicilio del CSV a la calle de los contactos que la tengan vacía, incluido el texto 'Sin dirección'. No pisa ninguna dirección ya cargada. ¿Continuar?"/>
            <button name="action_drop_staging" type="object" class="btn-secondary"
                    string="Borrar staging" invisible="state in ('draft', 'processing', 'applying')"
                    confirm="Se borra la tabla staging con el detalle fila por fila. ¿Continuar?"/>
            <!-- Una barra por tipo: clientes no tiene la fase de aplicación. -->
            <field name="state" widget="statusbar"
                   statusbar_visible="draft,ready,processing,done"
                   invisible="import_type == 'inventario'"/>
            <field name="state" widget="statusbar"
                   statusbar_visible="draft,ready,processing,done,applying,applied,posting,posted"
                   invisible="import_type != 'inventario'"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="name" placeholder="Nombre de la importación..."/></h1>
            </div>

            <div class="alert alert-danger" role="alert" invisible="file_ok">
              <strong>El archivo de origen no está accesible.</strong>
              <field name="file_info" readonly="1" nolabel="1" class="oe_inline"/>
            </div>
            <div class="alert alert-info" role="alert"
                 invisible="not file_ok or state != 'draft'">
              El archivo se lee del filesystem del servidor, desde adentro del módulo.
              No se sube por la interfaz ni se guarda en la base.
            </div>

            <group>
              <group string="Archivo de origen">
                <field name="import_type" readonly="state != 'draft'"/>
                <field name="file_path" readonly="1"/>
                <field name="file_info" readonly="1"/>
                <field name="file_path_resolved" readonly="1"
                       groups="base.group_no_one"/>
                <field name="file_ok" invisible="1"/>
              </group>
              <group string="Staging">
                <field name="staging_table" readonly="1"/>
                <field name="total_rows" readonly="1"/>
              </group>
            </group>

            <group string="Configuración">
              <group invisible="import_type != 'clientes'">
                <field name="reference_partner_id"
                       required="import_type == 'clientes'"
                       readonly="state not in ('draft', 'ready')"
                       options="{'no_create': True}"/>
                <field name="loyalty_program_id"
                       required="import_type == 'clientes'"
                       readonly="state not in ('draft', 'ready')"
                       options="{'no_create': True}"/>
                <field name="doc_type_id"
                       required="import_type == 'clientes'"
                       readonly="state not in ('draft', 'ready')"
                       options="{'no_create': True}"/>
              </group>
              <group invisible="import_type != 'inventario'">
                <field name="inventory_user_id"
                       required="import_type == 'inventario'"
                       readonly="state not in ('draft', 'ready', 'done')"
                       options="{'no_create': True}"/>
                <field name="inventory_reason"
                       readonly="state not in ('draft', 'ready', 'done')"
                       placeholder="Se completa solo al cargar"/>
                <field name="inventory_accounting_date"
                       readonly="state in ('applying', 'applied')"
                       placeholder="Vacía: la fecha del apply"/>
                <field name="apply_batch_size" readonly="state == 'applying'"/>
                <field name="post_batch_size" readonly="state == 'posting'"/>
                <field name="rec_batch_size" readonly="state == 'reconciling'"/>
              </group>
              <group>
                <field name="batch_size" readonly="state == 'processing'"/>
                <field name="batches_per_run" readonly="state == 'processing'"/>
                <field name="points_mode" readonly="state == 'processing'"
                       invisible="import_type != 'clientes'"/>
                <field name="street_placeholder" readonly="state == 'processing'"
                       invisible="import_type != 'clientes'"
                       placeholder="Dejar vacío para no completar la calle"/>
                <field name="backup_dir" readonly="state == 'processing'"/>
              </group>
            </group>

            <!-- Avance en vivo: el widget hace polling mientras el estado sea
                 processing/loading y se apaga solo al terminar. Los campos van
                 declarados (invisibles) porque el widget los lee del record. -->
            <group string="Avance" invisible="state == 'draft'">
              <field name="progress" widget="forum_import_progress" nolabel="1" colspan="2"/>
              <field name="import_type" invisible="1"/>
              <field name="offset" invisible="1"/>
              <field name="total_rows" invisible="1"/>
              <field name="processed" invisible="1"/>
              <field name="created" invisible="1"/>
              <field name="updated" invisible="1"/>
              <field name="ignored" invisible="1"/>
              <field name="errors" invisible="1"/>
              <field name="cards_from_pool" invisible="1"/>
              <field name="cards_created" invisible="1"/>
              <field name="cards_updated" invisible="1"/>
              <field name="quants_created" invisible="1"/>
              <field name="quants_updated" invisible="1"/>
              <field name="quants_zero" invisible="1"/>
              <field name="current_phase" invisible="1"/>
              <field name="apply_total" invisible="1"/>
              <field name="apply_processed" invisible="1"/>
              <field name="applied_count" invisible="1"/>
              <field name="apply_no_diff" invisible="1"/>
              <field name="apply_errors" invisible="1"/>
              <field name="apply_via_orm" invisible="1"/>
              <field name="apply_layers_valued" invisible="1"/>
              <field name="apply_entries" invisible="1"/>
              <field name="apply_step" invisible="1"/>
              <field name="post_total" invisible="1"/>
              <field name="post_done" invisible="1"/>
              <field name="post_errors" invisible="1"/>
              <field name="post_step" invisible="1"/>
              <field name="post_started_at" invisible="1"/>
              <field name="post_ended_at" invisible="1"/>
              <field name="rec_total" invisible="1"/>
              <field name="rec_done" invisible="1"/>
              <field name="rec_errors" invisible="1"/>
              <field name="rec_lines" invisible="1"/>
              <field name="rec_step" invisible="1"/>
              <field name="rec_started_at" invisible="1"/>
              <field name="rec_ended_at" invisible="1"/>
              <field name="check_state" invisible="1"/>
              <field name="apply_started_at" invisible="1"/>
              <field name="apply_ended_at" invisible="1"/>
              <field name="started_at" invisible="1"/>
              <field name="ended_at" invisible="1"/>
              <field name="loading_step" invisible="1"/>
              <field name="loading_steps_total" invisible="1"/>
              <field name="loading_phase" invisible="1"/>
              <field name="loading_started_at" invisible="1"/>
            </group>

            <group string="Verificación por invariantes"
                   invisible="import_type != 'inventario' or check_state == 'pendiente'">
              <field name="check_state" readonly="1"/>
              <field name="check_at" readonly="1"/>
              <field name="check_report" readonly="1" nolabel="1" colspan="2"
                     widget="text" class="font-monospace small"/>
            </group>

            <group string="Detalle" invisible="state == 'draft'">
              <group>
                <field name="offset" readonly="1" string="Puntero (fila)"/>
                <field name="started_at" readonly="1"/>
                <field name="ended_at" readonly="1" invisible="not ended_at"/>
              </group>
              <group invisible="import_type != 'inventario' or current_phase != 'apply'">
                <field name="apply_offset" readonly="1" string="Puntero de aplicación (celda)"/>
                <field name="apply_started_at" readonly="1"/>
                <field name="apply_ended_at" readonly="1" invisible="not apply_ended_at"/>
              </group>
              <group invisible="import_type != 'clientes'">
                <field name="updated" readonly="1"
                       help="Clientes que ya existían. De estos solo se tocan los puntos, no sus datos."/>
                <field name="pool_available" readonly="1"
                       help="Consultado en vivo sobre la base actual."/>
                <field name="backup_path" readonly="1"/>
              </group>
            </group>

            <notebook>
              <page string="Log" name="log">
                <field name="error_log" readonly="1" widget="text" nolabel="1"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_forum_import_batch_tree" model="ir.ui.view">
      <field name="name">forum.import.batch.tree</field>
      <field name="model">forum.import.batch</field>
      <field name="arch" type="xml">
        <tree string="Importaciones FORUM"
              decoration-success="state == 'done'"
              decoration-danger="state == 'error'"
              decoration-warning="state == 'processing'"
              decoration-muted="state == 'cancel'">
          <field name="name"/>
          <field name="import_type"/>
          <field name="create_date" string="Creada"/>
          <field name="total_rows"/>
          <field name="processed"/>
          <field name="progress" widget="progressbar"/>
          <field name="created"/>
          <field name="updated"/>
          <field name="errors"/>
          <field name="cards_from_pool" string="Pool"/>
          <field name="cards_created" string="Nuevas"/>
          <field name="state" widget="badge"
                 decoration-success="state == 'done'"
                 decoration-danger="state == 'error'"
                 decoration-warning="state == 'processing'"/>
        </tree>
      </field>
    </record>

    <record id="action_forum_import_batch" model="ir.actions.act_window">
      <field name="name">Importación FORUM</field>
      <field name="res_model">forum.import.batch</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Crear una importación</p>
        <p>
          Carga masiva de clientes y puntos desde el CSV incluido en el módulo.
          El proceso corre por tandas en segundo plano.
        </p>
      </field>
    </record>

    <menuitem id="menu_forum_import_batch"
              name="Importación FORUM"
              parent="contacts.menu_contacts"
              action="action_forum_import_batch"
              groups="base.group_system"
              sequence="90"/>

  </data>
</odoo>
