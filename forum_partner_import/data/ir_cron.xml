<odoo>
  <data noupdate="0">
    <!-- Procesa las tandas pendientes.

         Queda SIEMPRE activo, con un intervalo largo. No se prende y se apaga
         solo: `ir.cron.write()` llama a `_try_lock()`, que pide un lock sobre
         su propia fila, y esa fila ya está bloqueada por el cursor que está
         ejecutando el job. Cualquier intento de auto-desactivarse desde adentro
         del propio cron falla siempre con LockNotAvailable.

         El trabajo se dispara con `_trigger()`, que hace correr un cron activo
         al instante sin importar el `nextcall` (ver `_get_all_ready_jobs`, que
         exige `active = true` pero acepta un trigger pendiente). El intervalo
         de 10 minutos es solo la red de seguridad: si el servidor se cae con un
         batch a medias, la cadena de triggers se corta y este tick lo retoma.

         noupdate="0" a propósito: la definición manda, y cada -u vuelve a dejar
         el cron en el estado correcto aunque haya quedado apagado a mano. -->
    <record id="ir_cron_forum_partner_import" model="ir.cron">
      <field name="name">FORUM: importación masiva de clientes</field>
      <field name="model_id" ref="model_forum_import_batch"/>
      <field name="state">code</field>
      <field name="code">model._cron_procesar()</field>
      <field name="interval_number">10</field>
      <field name="interval_type">minutes</field>
      <field name="numbercall">-1</field>
      <field name="doall" eval="False"/>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
