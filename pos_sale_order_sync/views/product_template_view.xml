<?xml version="1.0"?>
<odoo>
    <!-- El check vive en la pestaña Ventas y no en Inventario: en Inventario solo
         se veía en almacenables y consumibles (el grupo Logistics se oculta en
         servicios) y además requería el grupo product.group_stock_packaging. -->
    <record id="product_template_form_sale_tab" model="ir.ui.view">
        <field name="name">product_template_form_sale_tab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group name="forum_franquicia" string="Franquicias">
                    <field name="excluir_logica_franquicia"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
