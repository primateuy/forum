<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="setu_interwarehouse_channel_form_forum_picking_type" model="ir.ui.view">
        <field name="name">setu.interwarehouse.channel.form.forum.picking.type</field>
        <field name="model">setu.interwarehouse.channel</field>
        <field name="inherit_id" ref="setu_intercompany_transaction.setu_interwarehouse_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validate_ict']" position="after">
                <field name="picking_type_id"
                       options="{'no_create': 1, 'no_create_edit': 1}"/>
                <field name="picking_type_wms_integration"
                       invisible="not picking_type_id"/>
                <field name="requestor_picking_type_id"
                       invisible="transfer_with_single_picking"
                       options="{'no_create': 1, 'no_create_edit': 1}"/>
                <field name="requestor_picking_type_wms_integration"
                       invisible="transfer_with_single_picking or not requestor_picking_type_id"/>
            </xpath>
        </field>
    </record>

    <record id="setu_interwarehouse_channel_tree_forum_picking_type" model="ir.ui.view">
        <field name="name">setu.interwarehouse.channel.tree.forum.picking.type</field>
        <field name="model">setu.interwarehouse.channel</field>
        <field name="inherit_id" ref="setu_intercompany_transaction.setu_interwarehouse_channel_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validate_ict']" position="after">
                <field name="picking_type_id" optional="show"/>
                <field name="picking_type_wms_integration" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
