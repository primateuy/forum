<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_autoinvoice_wizard_form" model="ir.ui.view">
        <field name="name">sale.autoinvoice.wizard.form</field>
        <field name="model">sale.autoinvoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar por límite de líneas">
                <sheet>
                    <div class="alert alert-info" role="alert" style="margin-bottom: 16px;">
                        <field name="warning_message" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_count" string="Facturas a emitir"/>
                            <field name="orders_to_invoice_count" string="Órdenes a facturar"/>
                            <field name="lines_to_invoice" string="Líneas a facturar"/>
                        </group>
                        <group>
                            <field name="max_lineas" string="Límite del punto de emisión"/>
                            <field name="orders_skipped_count" string="Órdenes salteadas"/>
                            <field name="lines_skipped" string="Líneas salteadas"
                                   invisible="not has_skipped"/>
                        </group>
                    </group>
                    <group string="Detalle por factura">
                        <field name="detail_message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Órdenes salteadas" invisible="not has_skipped">
                        <div class="alert alert-warning" role="alert" colspan="2">
                            Estas órdenes no entran en ninguna factura porque por sí solas
                            superan el tope de líneas del punto de emisión, o no tienen
                            líneas facturables. Quedan sin facturar.
                        </div>
                        <field name="orders_skipped_ids" nolabel="1"
                               widget="many2many_tags" readonly="1" colspan="2"/>
                    </group>
                    <field name="has_skipped" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_create_invoice" type="object"
                            string="Generar Facturas" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de servidor desde la vista lista de órdenes de venta -->
    <data noupdate="0">
        <record id="action_sale_autoinvoice_by_limit" model="ir.actions.server">
            <field name="name">Facturar por límite de líneas</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list</field>
            <field name="groups_id" eval="[(4, ref('pos_sale_order_sync_autoinvoice.group_facturacion_franquicias'))]"/>
            <field name="state">code</field>
            <field name="code">action = records.action_autoinvoice_by_limit()</field>
        </record>
    </data>
</odoo>
