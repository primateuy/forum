<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="setu_intercompany_channel_form_forum_picking_type" model="ir.ui.view">
        <field name="name">setu.intercompany.channel.form.forum.picking.type</field>
        <field name="model">setu.intercompany.channel</field>
        <field name="inherit_id" ref="setu_intercompany_transaction.setu_intercompany_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auto_workflow_id']" position="after">
                <field name="picking_type_id"
                       options="{'no_create': 1, 'no_create_edit': 1}"/>
                <field name="picking_type_wms_integration"
                       invisible="not picking_type_id"/>
                <field name="requestor_picking_type_id"
                       options="{'no_create': 1, 'no_create_edit': 1}"/>
                <field name="requestor_picking_type_wms_integration"
                       invisible="not requestor_picking_type_id"/>
            </xpath>
        </field>
    </record>
</odoo>
