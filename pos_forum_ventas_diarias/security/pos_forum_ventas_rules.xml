<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Recorte por punto de venta.

         Limita lo que ve el grupo de consulta a los PDV cargados en el campo
         «Puntos de venta permitidos» (allowed_pos) de la ficha del usuario,
         que aporta el módulo pos_restrict.

         IMPORTANTE: un usuario de este grupo SIN puntos de venta asignados no
         ve ningún pago. No es un error de la vista: hay que cargarle los PDV.

         La regla no aplica a los administradores del punto de venta ni a los
         usuarios que no tengan el grupo, que siguen viendo lo de siempre. -->
    <record id="rule_pos_payment_allowed_pos" model="ir.rule">
        <field name="name">Pagos del POS: solo los puntos de venta asignados</field>
        <field name="model_id" ref="point_of_sale.model_pos_payment"/>
        <field name="groups" eval="[(4, ref('group_pos_payment_report'))]"/>
        <field name="domain_force">[('config_id', 'in', user.allowed_pos.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
